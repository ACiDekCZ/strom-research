{
  "name": "strom-research",
  "version": "1.13.0",
  "description": "Genealogical research toolkit for AI coding agents",
  "type": "module",
  "bin": {
    "strom": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "strom": "node src/cli.ts",
    "test": "node --test --import ./test/setup.ts --test-timeout=240000 --test-reporter=dot \"test/**/*.test.ts\"",
    "test:quick": "node --test --import ./test/setup.ts --test-timeout=240000 --test-reporter=dot \"test/unit/**/*.test.ts\" \"test/gedcom/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "prepublishOnly": "node scripts/npm-channel.ts",
    "release": "node scripts/build-release.ts"
  },
  "keywords": [
    "genealogy",
    "family-tree",
    "gedcom",
    "research",
    "cli"
  ],
  "author": "Milan Víšek",
  "contributors": [
    "Claude (Anthropic)"
  ],
  "homepage": "https://github.com/ACiDekCZ/strom-research#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ACiDekCZ/strom-research.git"
  },
  "bugs": "https://github.com/ACiDekCZ/strom-research/issues",
  "license": "AGPL-3.0-or-later AND MIT",
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2"
  }
}
